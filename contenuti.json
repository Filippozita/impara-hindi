            { "id": "l1-meraa-dost", "it": "Questo è il mio amico", "translit": "ye meraa dost hai", "devanagari": "ये मेरा दोस्त है", "tipo": "frase", "nota": "Per un'amica: \"ye merii dost hai\"." }
