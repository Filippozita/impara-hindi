            { "id": "l1-kahaan-se", "it": "Di dove sei?", "translit": "aap kahaan se hain?", "devanagari": "आप कहाँ से हैं?", "tipo": "frase" },
            { "id": "l1-itlii-se", "it": "Vengo dall'Italia", "translit": "main Itlii se huun", "devanagari": "मैं इटली से हूँ", "tipo": "frase", "nota": "\"Itlii\" è il nome dell'Italia in hindi." },
            { "id": "l1-angrezii", "it": "Parli inglese?", "translit": "kyaa aap angrezii bolte hain?", "devanagari": "क्या आप अंग्रेज़ी बोलते हैं?", "tipo": "frase", "nota": "Rivolta a un uomo. A una donna: \"boltii hain\".", "parole": { "kyaa": "(apre una domanda sì/no)" } },
